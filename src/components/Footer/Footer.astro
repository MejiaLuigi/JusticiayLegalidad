---
import "./Footer.css";
import { Icon } from "astro-icon/components";
---

<footer class="footer-container">
  <div class="footer-content">
    <div class="footer-left">
      <div class="footer-logo">
        <img
          src="/ImagoTipo_White.svg"
          alt="Justicia & Legalidad Logo"
          class="logo"
        />
      </div>
      <p class="footer-description">
        Excelencia legal con un toque humano. Defendiendo sus derechos con
        pasión y profesionalismo desde 2006.
      </p>
      <div class="footer-icons">
        <a href="#" class="icon-box">
          <Icon name="simple-icons:linkedin" />
        </a>
        <a href="#" class="icon-box">
          <Icon name="simple-icons:instagram" />
        </a>
        <a href="#" class="icon-box">
          <Icon name="simple-icons:x" />
        </a>
      </div>
    </div>
    <div class="footer-info">
      <div class="content-links">
        <h3>Enlaces</h3>
        <ul>
          <li><a href="/">Home</a></li>
          <li><a href="/">About Me</a></li>
          <li><a href="/">Services</a></li>
          <li><a href="/">Experience</a></li>
          <li><a href="/">Contact</a></li>
        </ul>
      </div>
      <div class="content-services">
        <h3>Servicios</h3>
        <p>Derecho Civil</p>
        <p>Derecho Penal</p>
        <p>Derecho Corporativo</p>
        <p>Derecho Laboral</p>
        <p>Derecho de Familia</p>
      </div>
      <div class="content-contact">
        <h3>Contacto</h3>
        <p>Actualmente en servicio Colombia (Mellín, Montería, Ibague, Urabá)</p>
        <p>(+57) 312 787 1271</p>
        <p>hoyos1420@gmail.com</p>
      </div>
    </div>
  </div>
  <hr />
  <div class="footer-bottom">
    <p class="footer-copyright">
     <a href="/">LuigiMejia - Dev</a> &copy; 2026 Justicia & Legalidad. Todos los derechos
      reservados.
    </p>
    <div class="footer-terms">
      <a href="/">Aviso de Privacidad</a>
      <a href="/">Terminos & Condiciones</a>
    </div>
  </div>
</footer>
